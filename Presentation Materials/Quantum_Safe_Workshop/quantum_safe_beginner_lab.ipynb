    "    - 'is_quantum_vulnerable': bool\n",
    "    - 'nist_standard_category': str ('FIPS 203', 'FIPS 204', 'Legacy', 'Deprecated', or 'Quantum Safe')\n",
    "    - 'recommended_action': str\n",
    "    \"\"\"\n",
    "    algo = algorithm_name.upper().strip()\n",
    "    \n",
    "    # TODO: Implement the classification logic below\n",
    "    # Hint: Check for sub-strings like \"RSA\", \"ECDSA\", \"3DES\", \"AES\", \"ML-KEM\", \"ML-DSA\"\n",
    "    # Ensure you handle key size verification for AES!\n",
    "    \n",
    "    is_quantum_vulnerable = True\n",
    "    nist_standard_category = \"Legacy\"\n",
    "    recommended_action = \"Migrate to ML-KEM\"\n",
    "    \n",
    "    # Remove this return and write your logic\n",
    "    return {\n",
    "        \"is_quantum_vulnerable\": is_quantum_vulnerable,\n",
